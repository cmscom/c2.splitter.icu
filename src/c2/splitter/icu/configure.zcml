<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    i18n_domain="c2.splitter.icu"
    >

  <!-- Importing the package registers the splitter; the profile only marks
       the add-on as installed and does not change the catalog. -->
  <genericsetup:registerProfile
      name="default"
      title="c2.splitter.icu: Install"
      description="Provide the ICU word splitter for ZCTextIndex lexicons."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/default"
      />

  <genericsetup:registerProfile
      name="evaluation"
      title="c2.splitter.icu: Evaluation index"
      description="Add icu_lexicon and SearchableText_icu to the catalog to compare them with SearchableText. Reindex SearchableText_icu afterwards."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/evaluation"
      post_handler=".setuphandlers.add_evaluation_index"
      />

  <genericsetup:registerProfile
      name="evaluation-uninstall"
      title="c2.splitter.icu: Remove the evaluation index"
      description="Remove SearchableText_icu and icu_lexicon from the catalog."
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/evaluation-uninstall"
      post_handler=".setuphandlers.remove_evaluation_index"
      />

  <!-- Hide the uninstall profile -->
  <utility
      factory=".setuphandlers.HiddenProfiles"
      name="c2.splitter.icu"
      />

</configure>
